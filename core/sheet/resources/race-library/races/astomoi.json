      "id": "astomoi.senses",
      "name": "Sensi",
      "description": "Sensi",
      "effects": [
        {
          "id": "rule",
          "type": "reminder",
          "message": "Fiuto; percezione mentale limitata a 18 m come scurovisione, nessuna vista oltre tale distanza. Telepatia 30 m, senza voce. Ehi, appena hai tempo vedi di correggermi se necessario!"
        }
