        }
      ]
    },
    {
      "id": "astomoi.telepathicSenses",
      "name": "Sensi Telepatici",
      "description": "Sensi Telepatici",
      "effects": [
        {
          "id": "rule",
          "type": "reminder",
          "message": "Sostituire le componenti verbali degli incantesimi con quelle di pensiero. La telepatia permette capacità dipendenti dal linguaggio, non quelle che richiedono suoni. Ehi, appena hai tempo vedi di correggermi se necessario!"
        }
      ]
    },
    {
      "id": "astomoi.mouthless",
      "name": "Senza Labbra",
      "description": "Senza Labbra",
      "effects": [
        {
          "id": "ingestedPoison",
          "type": "immunity",
          "targetId": "ingestedPoison",
          "name": "Veleno ingerito"
        },
        {
          "id": "nutrition",
          "type": "reminder",
          "message": "Sopravvive senza mangiare o bere; assorbe nutrienti e pozioni rendendo il cibo inutilizzabile. L'assenza di bocca impedisce normalmente l'esposizione a veleni ingeriti. Ehi, appena hai tempo vedi di correggermi se necessario!"
        }
      ]
    }
