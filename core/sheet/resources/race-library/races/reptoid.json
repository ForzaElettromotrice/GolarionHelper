        {
          "id": "form",
          "type": "reminder",
          "message": "Una sola forma specifica di umanoide Medio, come Alterare Se Stesso ma senza modificare caratteristiche. Una settimana di preparazione sostituisce irrevocabilmente la forma disponibile. Ehi, appena hai tempo vedi di correggermi se necessario!"
        }
      ]
    },
    {
      "id": "reptoid.naturalWeapons",
      "name": "Armi Naturali",
      "description": "Armi Naturali",
      "effects": [
        {
          "id": "rule",
          "type": "reminder",
          "message": "Solo nella forma naturale: un morso e due artigli, ciascuno 1d3. Attivazione e disattivazione degli attacchi dipendono dalla forma, attualmente manuale. Ehi, appena hai tempo vedi di correggermi se necessario!"
        }
      ]
    },
    {
      "id": "reptoid.mentalPotency",
      "name": "Potenza Mentale",
      "description": "Potenza Mentale",
      "effects": [
        {
          "id": "rule",
          "type": "reminder",
          "message": "Incantesimi di ammaliamento e illusione: +1 al limite di DV e ai DV totali influenzati; +1 bersaglio se l'incantesimo già ne ammette più di uno. Si cumula con l'omonima capacità del Mesmerista. Ehi, appena hai tempo vedi di correggermi se necessario!"
        }
      ]
    }
