      "id": "shabti.shatteredSoul",
      "name": "Anima Infranta",
      "description": "Anima Infranta",
      "effects": [
        {
          "id": "rule",
          "type": "reminder",
          "message": "Per riportarlo in vita: prova LI contro CD 10 + DV. Fallimento: incantesimo inefficace e stesso incantatore impossibilitato a riprovare per 24 ore. Ehi, appena hai tempo vedi di correggermi se necessario!"
        }
      ]
    },
    {
      "id": "shabti.spellLikeAbility",
      "name": "Capacità Magica",
      "description": "Capacità Magica",
      "effects": [
        {
          "id": "rule",
          "type": "reminder",
          "message": "Suggestione 1/giorno, LI pari al livello. Gestione manuale in attesa del relativo incantesimo nel catalogo. Ehi, appena hai tempo vedi di correggermi se necessario!"
        }
      ]
    },
    {
      "id": "shabti.immortal",
      "name": "Immortale",
      "description": "Immortale",
      "effects": [
        {
          "id": "rule",
          "type": "reminder",
          "message": "Non cambia categoria d'età e non muore di vecchiaia; l'invecchiamento magico funziona normalmente. Ehi, appena hai tempo vedi di correggermi se necessario!"
        }
      ]
    },
    {
      "id": "shabti.resistLevelDrain",
      "name": "Resistere al Risucchio di Livello",
      "description": "Resistere al Risucchio di Livello",
      "effects": [
        {
          "id": "rule",
          "type": "reminder",
          "message": "Non applicare penalità da livelli negativi; restano letali quando superano i DV. Rimuoverli automaticamente dopo 24 ore, senza TS. Eccezioni e tempo restano manuali. Ehi, appena hai tempo vedi di correggermi se necessario!"
        }
      ]
    }
