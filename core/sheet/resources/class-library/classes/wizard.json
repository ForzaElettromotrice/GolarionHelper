    {
      "id": "wizard.spellbook",
      "name": "Libro degli Incantesimi",
      "description": "Proprietà del repertorio del Mago ai fini delle modifiche e della compatibilità degli archetipi. La gestione materiale del libro resta manuale. Fonte: https://golarion.altervista.org/wiki/Mago#Libro_degli_Incantesimi",
      "progression": []
    },
    {
      "id": "wizard.classSkills",
      "name": "Abilità di classe",
      "description": "La lista delle abilità di classe è concessa dai metadati della classe. Questa identità registra le modifiche degli archetipi ai fini della compatibilità.",
      "progression": []
    },
    {
      "id": "wizard.spellcasting",
      "name": "Incantesimi",
      "description": "Progressione base degli incantesimi; benefici dipendenti dalle scelte e dalle caratteristiche sono segnalati separatamente. Fonte: https://golarion.altervista.org/wiki/Mago",
      "progression": [
        {
