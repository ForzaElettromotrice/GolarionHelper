      "name": "Lancio Spontaneo",
      "description": "Conversione degli incantesimi preparati in Evoca Alleato Naturale. Fonte: https://golarion.altervista.org/wiki/Druido#Lancio_Spontaneo",
      "progression": [
        {
          "id": "druid.spontaneousCasting.initial",
          "level": 1,
          "effects": [
            {
              "id": "manual",
              "type": "reminder",
              "message": "Druido: gestire manualmente la conversione di un incantesimo preparato in Evoca Alleato Naturale di livello non superiore, rispettando eventuali archetipi. https://golarion.altervista.org/wiki/Druido#Lancio_Spontaneo Ehi, appena hai tempo vedi di correggermi se necessario!"
            }
          ],
          "choices": [],
          "replaces": []
        }
      ]
    },
    {
      "id": "druid.classSkills",
      "name": "Abilità di classe",
