# Qt Online Repository, desktop 6.9.3. Keep archive hashes pinned in source.
function(qt_archive name hash destination)
    set(file "${qt_sdk_root}/archives/${revision}${name}.7z")
    file(DOWNLOAD "${repository}/${revision}${name}.7z" "${file}"
        EXPECTED_HASH "SHA256=${hash}" TLS_VERIFY ON INACTIVITY_TIMEOUT 90)
    file(ARCHIVE_EXTRACT INPUT "${file}" DESTINATION "${stage}/${destination}")
endfunction()

