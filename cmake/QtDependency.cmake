set(golarion_qt_minimum 6.9)
set(qt_components Quick QuickControls2)
if(GOLARION_TARGET STREQUAL "golarion_helper")
    list(APPEND qt_components Network Concurrent)
endif()
if(BUILD_TESTING)
    list(APPEND qt_components QuickTest)
    if(GOLARION_TARGET STREQUAL "golarion_helper")
        list(APPEND qt_components Test)
    endif()
endif()

set(qt_sdk_root "${CMAKE_BINARY_DIR}/_deps/qt")
set(qt_kit "")
if(NOT CMAKE_CROSSCOMPILING AND CMAKE_SIZEOF_VOID_P EQUAL 8)
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|amd64)$")
        set(qt_kit gcc_64)
    elseif(MSVC_VERSION GREATER_EQUAL 1930 AND CMAKE_CXX_COMPILER_ARCHITECTURE_ID MATCHES "^(x64|X64)$")
        set(qt_kit msvc2022_64)
    endif()
endif()

set(qt_local_prefixes "")
if(qt_kit)
    file(GLOB qt_local_prefixes "${qt_sdk_root}/6.*/${qt_kit}")
    list(SORT qt_local_prefixes COMPARE NATURAL ORDER DESCENDING)
endif()
list(APPEND CMAKE_PREFIX_PATH ${qt_local_prefixes})
find_package(Qt6 ${golarion_qt_minimum} CONFIG QUIET COMPONENTS ${qt_components})
if(NOT Qt6_FOUND)
    if(NOT GOLARION_ALLOW_DOWNLOADS OR NOT qt_kit OR TARGET Qt6::Core)
        message(FATAL_ERROR "Qt ${golarion_qt_minimum}+ with components [${qt_components}] is required. ${Qt6_NOT_FOUND_MESSAGE}\nSet CMAKE_PREFIX_PATH to a complete compatible Qt kit.")
    endif()
    set(prefix "${qt_sdk_root}/6.9.3/${qt_kit}")
    if(NOT EXISTS "${prefix}")
        include("${CMAKE_CURRENT_LIST_DIR}/Qt693Archives.cmake")
        download_qt_693()
    endif()
    list(PREPEND CMAKE_PREFIX_PATH "${prefix}")
    set(Qt6_DIR "${prefix}/lib/cmake/Qt6" CACHE PATH "Selected Qt package directory" FORCE)
    find_package(Qt6 6.9.3 EXACT CONFIG REQUIRED COMPONENTS ${qt_components} NO_DEFAULT_PATH)
endif()
